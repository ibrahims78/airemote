{
  "name": "airemote-agent-desktop",
  "version": "3.14.3",
  "description": "AiRemote Agent — Windows Desktop Application",
  "author": "AiRemote <support@airemote.io>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:gdi": "node ../../scripts/build-gdi-worker.cjs",
    "build": "node ../../scripts/build-gdi-worker.cjs && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64",
    "build:portable": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64 --config.win.target=portable",
    "build:dir": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "io.airemote.agent",
    "productName": "AiRemote Agent",
    "copyright": "Copyright © 2025 AiRemote",
    "artifactName": "AiRemote-Agent-v${version}-Windows-x64.zip",
    "directories": {
      "output": "../../releases/agent-windows"
    },
    "files": [
      "main.js",
      "preload.js",
      "rtc.html",
      "lib/**/*",
      "chat-preload.js",
      "chat-toast-preload.js",
      "renderer/**/*",
      "build/icon.ico"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": false,
      "signingHashAlgorithms": null,
      "artifactName": "AiRemote-Agent-v${version}-Windows-x64.zip"
    },
    "publish": null,
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AiRemote Agent",
      "artifactName": "AiRemote-Agent-Setup-v${version}-x64.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  }
}
