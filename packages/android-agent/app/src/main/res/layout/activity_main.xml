<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_bg">

    <!-- ══ Titlebar ══ -->
    <LinearLayout
        android:id="@+id/titlebar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@color/app_surface2">

        <TextView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/logo_bg"
            android:gravity="center"
            android:text="Ai"
            android:textColor="@color/app_on_accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_ver_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_ghost"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="v3.8.1"
            android:textColor="@color/app_muted"
            android:textSize="9sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="9dp"
            android:text="AiRemote Agent"
            android:textColor="@color/app_ink"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />



        <View
            android:id="@+id/status_dot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:background="@drawable/btn_ghost" />

        <TextView
            android:id="@+id/tb_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/state_stopped"
            android:textColor="@color/app_muted"
            android:textSize="10sp" />
            <TextView
            android:id="@+id/tb_lang_ar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:minWidth="32dp"
            android:minHeight="32dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="ع"
            android:textColor="@color/app_accent"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tb_lang_en"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minWidth="32dp"
            android:minHeight="32dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="EN"
            android:textColor="@color/app_muted"
            android:textSize="12sp" />

        <!-- 3.16.16 — one theme chip; it always shows the mode you would switch to -->
        <TextView
            android:id="@+id/tb_theme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:minWidth="36dp"
            android:minHeight="32dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/theme_dark"
            android:textColor="@color/app_accent"
            android:textSize="12sp" />
        </LinearLayout>

    <!-- ══ Tabs ══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:background="@color/app_surface2">

        <TextView
            android:id="@+id/tab_status"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@color/app_surface"
            android:gravity="center"
            android:text="@string/app_state"
            android:textColor="@color/app_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tab_ai"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@color/app_surface"
            android:gravity="center"
            android:text="@string/app_ai"
            android:textColor="@color/app_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tab_chat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@color/app_surface"
            android:gravity="center"
            android:text="@string/app_chat"
            android:textColor="@color/app_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tab_log"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/app_surface"
            android:gravity="center"
            android:text="@string/app_log"
            android:textColor="@color/app_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ══ Status pane ══ -->
        <ScrollView
            android:id="@+id/pane_status"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Setup card -->
                <LinearLayout
                    android:id="@+id/setup_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/card_bg"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <Button
                        android:id="@+id/btn_setup"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/btn_ghost"
                        android:text="@string/setup_wizard"
                        android:textColor="@color/app_on_accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Status card -->
                <LinearLayout
                    android:id="@+id/status_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_bg"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:id="@+id/card_dot"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@drawable/btn_ghost" />

                        <TextView
                            android:id="@+id/status_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="@string/state_offline"
                            android:textColor="@color/app_ink"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn_start"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:background="@drawable/btn_primary"
                            android:text="@string/btn_start"
                            android:textColor="@color/app_on_accent"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btn_stop"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/btn_ghost"
                            android:text="@string/btn_stop"
                            android:textColor="@color/app_ink2"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/status_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/hint_press_start2"
                        android:textColor="@color/app_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Connection strip -->
                <LinearLayout
                    android:id="@+id/conn_strip_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/card_bg"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/conn_server"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lbl_server_dash"
                        android:textColor="@color/app_ink2"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/conn_devinfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/lbl_device_dash"
                        android:textColor="@color/app_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/conn_devid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:ellipsize="middle"
                        android:textColor="@color/app_subtle"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/conn_uptime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/lbl_uptime_dash"
                        android:textColor="@color/app_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                                <!-- 3.14.1 — PLAN §4: what Windows does and Android does not is declared, not hidden -->
                <LinearLayout
                    android:id="@+id/note_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/card_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/tab_active"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:text="@string/android_only_tag"
                        android:textColor="@color/app_accent"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/android_only_note"
                        android:textColor="@color/app_muted"
                        android:textSize="11sp" />
                </LinearLayout>


<!-- Settings -->
                <LinearLayout
                    android:id="@+id/settings_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/card_bg"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sec_settings"
                        android:textColor="@color/app_ink"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/fld_server"
                        android:textColor="@color/app_muted"
                        android:textSize="10sp" />

                    <EditText
                        android:id="@+id/inp_server"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:background="@drawable/input_bg"
                        android:hint="ws://IP:3001/ws"
                        android:inputType="textUri"
                        android:padding="9dp"
                        android:textColor="@color/app_ink"
                        android:textColorHint="@color/app_hint"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/fld_token"
                        android:textColor="@color/app_muted"
                        android:textSize="10sp" />

                    <EditText
                        android:id="@+id/inp_token"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:background="@drawable/input_bg"
                        android:inputType="textPassword"
                        android:padding="9dp"
                        android:textColor="@color/app_ink"
                        android:textSize="12sp" />

                                        <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/fld_auth_mode"
                        android:textColor="@color/app_muted"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_auth_consent"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_ghost"
                            android:text="@string/btn_auth_consent"
                            android:textColor="@color/app_ink2"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btn_auth_password"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_ghost"
                            android:text="@string/btn_auth_password"
                            android:textColor="@color/app_ink2"
                            android:textSize="12sp" />
                    </LinearLayout>
<TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/fld_ctrl_pw"
                        android:textColor="@color/app_muted"
                        android:textSize="10sp" />

                    <EditText
                        android:id="@+id/inp_ctrl_pw"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:background="@drawable/input_bg"
                        android:inputType="textPassword"
                        android:padding="9dp"
                        android:textColor="@color/app_ink"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_save"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_primary"
                            android:text="@string/btn_save"
                            android:textColor="@color/app_on_accent"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btn_del_pw"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_ghost"
                            android:text="@string/btn_clear_pw"
                            android:textColor="@color/app_ink2"
                            android:textSize="12sp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Resources -->
                <LinearLayout
                    android:id="@+id/resources_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/card_bg"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sec_resources"
                        android:textColor="@color/app_ink"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="44dp"
                            android:layout_height="wrap_content"
                            android:text="CPU"
                            android:textColor="@color/app_muted"
                            android:textSize="10sp" />

                        <ProgressBar
                            android:id="@+id/bar_cpu"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="8dp"
                            android:layout_weight="1"
                            android:progressDrawable="@android:drawable/progress_horizontal" />

                        <TextView
                            android:id="@+id/pct_cpu"
                            android:layout_width="44dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="—"
                            android:textColor="@color/app_ink2"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="44dp"
                            android:layout_height="wrap_content"
                            android:text="RAM"
                            android:textColor="@color/app_muted"
                            android:textSize="10sp" />

                        <ProgressBar
                            android:id="@+id/bar_ram"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="8dp"
                            android:layout_weight="1"
                            android:progressDrawable="@android:drawable/progress_horizontal" />

                        <TextView
                            android:id="@+id/pct_ram"
                            android:layout_width="44dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="—"
                            android:textColor="@color/app_ink2"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="44dp"
                            android:layout_height="wrap_content"
                            android:text="Disk"
                            android:textColor="@color/app_muted"
                            android:textSize="10sp" />

                        <ProgressBar
                            android:id="@+id/bar_disk"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="8dp"
                            android:layout_weight="1"
                            android:progressDrawable="@android:drawable/progress_horizontal" />

                        <TextView
                            android:id="@+id/pct_disk"
                            android:layout_width="44dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="—"
                            android:textColor="@color/app_ink2"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="8dp" />
            </LinearLayout>
        </ScrollView>

        <!-- ══ AI pane ══ -->
        <LinearLayout
            android:id="@+id/pane_ai"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="10dp">

            <TextView
                android:id="@+id/ai_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ai_hint"
                android:textColor="@color/app_subtle"
                android:textSize="10sp" />

            <ScrollView
                android:id="@+id/ai_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="6dp"
                android:background="@drawable/card_bg">

                <TextView
                    android:id="@+id/ai_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:text=""
                    android:textColor="@color/app_ink"
                    android:textSize="12sp" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/ai_input"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_bg"
                    android:hint="@string/ai_ph"
                    android:padding="9dp"
                    android:textColor="@color/app_ink"
                    android:textColorHint="@color/app_hint"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/ai_send"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/btn_primary"
                    android:text="@string/btn_send"
                    android:textColor="@color/app_on_accent"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ══ Viewer chat pane ══ -->
        <LinearLayout
            android:id="@+id/pane_chat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="10dp">

            <TextView
                android:id="@+id/chat_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/chat_hint"
                android:textColor="@color/app_subtle"
                android:textSize="10sp" />

            <ScrollView
                android:id="@+id/chat_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="6dp"
                android:background="@drawable/card_bg">

                <TextView
                    android:id="@+id/chat_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:text=""
                    android:textColor="@color/app_ink"
                    android:textSize="12sp" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/chat_input"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_bg"
                    android:hint="@string/chat_ph"
                    android:padding="9dp"
                    android:textColor="@color/app_ink"
                    android:textColorHint="@color/app_hint"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/chat_send"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/btn_primary"
                    android:text="@string/btn_send"
                    android:textColor="@color/app_on_accent"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ══ Log pane ══ -->
        <LinearLayout
            android:id="@+id/pane_log"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="10dp">

            <!-- 3.16.16 — search + copy, parity with the Windows agent log -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/log_search"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_bg"
                    android:hint="@string/log_search_hint"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:singleLine="true"
                    android:textColor="@color/app_ink"
                    android:textColorHint="@color/app_hint"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_copy_log"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/btn_ghost"
                    android:text="@string/log_copy"
                    android:textAllCaps="false"
                    android:textColor="@color/app_ink2"
                    android:textSize="12sp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/log_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/card_bg">

                <TextView
                    android:id="@+id/log_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:padding="10dp"
                    android:text="—"
                    android:textColor="@color/app_ink2"
                    android:textSize="10sp" />
            </ScrollView>

            <Button
                android:id="@+id/btn_clear_log"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_ghost"
                android:text="@string/btn_clear_log"
                android:textColor="@color/app_ink2"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ══ Footer ══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@color/app_surface2">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv_ver_bottom"
        android:text="v3.8.1 · AiRemote Agent"
            android:textColor="@color/app_subtle"
            android:textSize="9sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/footer_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/app_subtle"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
