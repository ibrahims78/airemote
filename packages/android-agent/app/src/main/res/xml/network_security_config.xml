<?xml version="1.0" encoding="utf-8"?>
<!-- v3.7.0 — trust the deployment CA in addition to the system store.
     Replace res/raw/airemote_ca.pem with your own server certificate. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/airemote_ca" />
        </trust-anchors>
    </base-config>
</network-security-config>
