releases/**/builder-effective-config.yaml

# Heavy release binaries & runtime data (stay out of git; use GitHub Releases)
/data/
releases/**/AiRemote-Agent-*-linux-x64
releases/**/AiRemote-Agent-*-linux-arm64
releases/**/AiRemote-Agent-*-macos-*

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db

