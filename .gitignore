# ── Database ────────────────────────────────────────────────
packages/server/data/

# ── Dependencies ─────────────────────────────────────────────
node_modules/
**/node_modules/

# ── Build output ─────────────────────────────────────────────
**/dist/
**/build/
!releases/
*.tsbuildinfo

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── Environment ──────────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ── Release binaries & archives ──────────────────────────────
releases/**/*.exe
releases/**/*.zip
releases/**/*.7z
releases/**/*.tar.gz
releases/**/win-unpacked/
releases/**/builder-debug.yml
releases/**/builder-effective-config.yaml

# Heavy release binaries & runtime data (stay out of git; use GitHub Releases)
/data/
releases/**/AiRemote-Agent-*-linux-x64
releases/**/AiRemote-Agent-*-linux-arm64
releases/**/AiRemote-Agent-*-macos-*

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Replit internal ──────────────────────────────────────────
.cache/

# Windows build outputs
releases/**/*.blockmap
releases/**/builder-debug.yml
releases/**/win-unpacked/

# توقيع الإصدارات — المفتاح الخاص لا يُرفع أبداً
releases/release-key*.pem
!releases/release-key.pub.pem

# Android build outputs (regenerated by gradle)
packages/android-agent/app/build/
packages/android-agent/build/

# 96 MB muxing binary, shipped via extraResources, never committed
packages/server-desktop/bin/ffmpeg.exe

# ── Lab junk: build caches, editor backups, release media ─────
packages/android-agent/.gradle/
packages/android-agent/build/
packages/server-desktop/server.bundle.js
*.bak-*
releases/**/*.apk
releases/**/*.idsig
outputs/**/*.png
outputs/**/*.jpg
outputs/**/*.mp4
outputs/**/*.zip

# generated test frames
outputs/**/rec-long/frames/
outputs/**/rec-long/list.txt


# Lab login cache (JWT) — never commit
tools/lab/.token.json

# GDI worker المترجم بـcsc.exe وقت البناء (scripts/build-gdi-worker.cjs)
packages/agent-desktop/lib/bin/
# نسخة العرض الفاتح من renderer — يكتبها scripts/shot-agent.cjs في كل تشغيل
outputs/**/phase3/agent-light/

# مفتاح توقيع أندرويد (نسخة المشروع — كان في %APPDATA%\\AiRemote\\signing ويضيع)
# secrets/airemote-release.jks + keystore-password.txt — لا يُرفع أبدًا
secrets/

# W2-9 — ثنائيات ثقيلة تُنزَّل وقت التثبيت (scripts/download-cloudflared.js)
packages/server-desktop/bin/cloudflared.exe

# W3-2 — سجلات بناء لا تُتتبع
srv-build-log*
agent-build-log*
