{
  "name": "airemote",
  "version": "3.16.4",
  "private": true,
  "description": "AiRemote — Open Source Remote Access + AI Agent Platform",
  "scripts": {
    "dev:server": "pnpm --filter @airemote/server dev",
    "dev:dashboard": "pnpm --filter @airemote/dashboard dev",
    "dev:agent": "pnpm --filter @airemote/agent dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "verify": "node scripts/verify.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "pnpm": "^11.5.1"
  },
  "pnpm": {
    "overrides": {
      "proxy-addr@2": "2.0.8",
      "fast-uri@2": "2.4.8",
      "fast-uri@3": "3.1.9",
      "form-data@4": "4.0.6",
      "follow-redirects@1": "1.16.2",
      "brace-expansion@2": "2.1.7"
    }
  }
}
