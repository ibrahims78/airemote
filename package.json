{
  "name": "airemote",
  "version": "3.17.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11.5.3"
  },
  "private": true,
  "description": "AiRemote — Open Source Remote Access + AI Agent Platform",
  "packageManager": "pnpm@11.28.12",
  "scripts": {
    "dev:server": "pnpm --filter @airemote/server dev",
    "dev:dashboard": "pnpm --filter @airemote/dashboard dev",
    "dev:agent": "pnpm --filter @airemote/agent dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "verify": "node scripts/verify.js",
    "test": "node scripts/run-tests.cjs",
    "coverage": "c8 --include packages/server --reporter=text-summary node scripts/run-tests.cjs"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "pnpm": "^11.28.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "c8": "^12.0.0"
  }
}
